# Perlite settings
#
# Copy this file to .env and adjust the values.
# - Docker: the .env next to the docker-compose files is passed to the perlite container.
# - No Docker: place the .env next to the perlite folder (preferred, outside of the web root)
#   or inside the perlite folder, helper.php reads it directly.
#
# Empty values fall back to the default shown in the comment.


# --- General Settings ---

# path to your vault / notes (default: Demo vault)
# - Docker: host path, relative to the docker-compose file or absolute, e.g. ./perlite/Demo or /srv/obsidian/MyVault
#   docker compose mounts it into the container, nothing to change in the compose file
# - No Docker: the vault has to be inside the perlite folder, e.g. Demo or ./perlite/Demo
NOTES_PATH=./perlite/Demo
# vault name shown in the UI (default: folder name of the vault, "Notes" with Docker)
VAULT_NAME=Demo
# start page, without .md (default: README)
HOME_FILE=README
# browser tab title (default: Perlite)
SITE_TITLE=Perlite


# --- Frontend Settings ---

# render single line breaks as <br> (default: true)
LINE_BREAKS=true
# disable the link preview popups (default: false)
DISABLE_POP_HOVER=false
# show table of contents (default: true)
SHOW_TOC=true
# show local graph (default: true)
SHOW_LOCAL_GRAPH=true
# default font size in px (default: 15)
FONT_SIZE=15
# comma separated list of folders to hide (default: none)
HIDE_FOLDERS=docs,private,trash
# show file names instead of full paths in links (default: true)
NICE_LINKS=true
# comma separated list of file types (next to .md files) to show in the navigation, click downloads them (default: none)
TREE_VISIBLE_EXTENSIONS=pdf,docx


# --- Advanced Settings ---

# allow access to md files in hidden folders (default: false)
HIDDEN_FILE_ACCESS=false
# use absolute paths instead of relative paths (default: false)
ABSOLUTE_PATHS=false
# uri path perlite is served from, e.g. /perlite/ (default: /)
URI_PATH=/
# escape raw html in notes (default: true)
HTML_SAFE_MODE=true
# use frontmatter 'title' or top level h1 instead of the filename (default: false)
ZETTELKASTEN_FILENAMES_ENABLED=false
# comma separated list of additional highlight.js languages (default: powershell)
HIGHLIGHTJS_LANGS=powershell,x86asm
# comma separated list of file types which can be linked (default: pdf,mp4)
ALLOWED_FILE_LINK_TYPES=pdf,mp4
# embed websites of canvas link cards as iframe: off, click (load on click) or auto (default: click)
# YouTube and Vimeo links are always embedded, many websites don't allow to be embedded
CANVAS_IFRAME_EMBEDS=click
# path to store the pre-rendered graph relations (default: system temp dir)
TEMP_PATH=


# --- Metadata Settings ---

# og:type (default: article)
SITE_TYPE=article
# og:image (default: Perlite screenshot)
SITE_IMAGE=https://raw.githubusercontent.com/secure-77/Perlite/main/screenshots/screenshot.png
# og:url (default: https://perlite.secure77.de)
SITE_URL=https://perlite.secure77.de
# og:description (default: A web based markdown viewer optimized for Obsidian Notes)
SITE_DESC="A web based markdown viewer optimized for Obsidian Notes"
# og:site_name (default: Perlite Demo)
SITE_NAME=Perlite Demo


# --- Profile Settings ---

# logo file inside the perlite folder, empty for no logo / profile section
SITE_LOGO=perlite.svg
# homepage link (default: SITE_URL)
SITE_HOMEPAGE=
# github link, empty for none
SITE_GITHUB=https://github.com/secure-77
# twitter handle, empty for none
SITE_TWITTER=@secure_sec77
